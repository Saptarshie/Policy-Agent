# =====================================================================
# Policy RAG Agent - configuration
# Copy this file to `.env` and edit. All values have sensible defaults.
# NOTE: quote values that contain leading/trailing spaces (see the two
# EMBED_*_PREFIX lines below) - dotenv strips trailing spaces otherwise.
# =====================================================================

# ---------------- LLM (any OpenAI-compatible endpoint) ----------------
# Examples:
#   Ollama:      LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama
#   LM Studio:   LLM_BASE_URL=http://localhost:1234/v1    LLM_API_KEY=lm-studio
#   vLLM:        LLM_BASE_URL=http://localhost:8000/v1    LLM_API_KEY=EMPTY
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
# Requested max output tokens (64k). If the endpoint rejects it, the client
# automatically halves it until the endpoint accepts (see llm.py).
MAX_OUTPUT_TOKENS=65536
TEMPERATURE=0.1
# Reasoning effort for the answer model: empty = provider default. This is the
# real cost/latency lever (a bigger MAX_OUTPUT_TOKENS ceiling costs nothing).
LLM_REASONING_EFFORT=

# ---------------- Agent ----------------
AGENT_MAX_STEPS=12
AGENT_MAX_OBS_CHARS=4000
# NO post-answer verifier: grounding rests on the prompt contract plus the
# deterministic citation check (every [doc § section] is resolved against the
# store). The faithfulness judge exists only as offline audit tooling
# (eval/calibrate_judge.py) - it is not called on the answer path.

# ---------------- Intent & triage layer ----------------
# One LLM call in front of the ReAct loop classifies the raw employee input
# (8 categories), decides the route (REACT_LOOP / DIRECT_REPLY / FAST_REFUSE),
# de-noises it into a neutral HR question and proposes 1-3 formal search
# queries. Non-HR input and prompt injections are refused here; workplace
# questions ALWAYS reach the retrieval agent, which owns coverage refusals.
INTENT_ENABLED=true
# Model for the classifier (empty -> LLM_MODEL). A small/cheap model is fine.
INTENT_MODEL=
# Output budget for the classifier. Too low truncates the JSON mid-object;
# 1500 is the measured safe floor for the v2 prompt.
INTENT_MAX_TOKENS=65536
# The classifier runs with reasoning off: measured 20/20 agreement with the
# default and 4.1s instead of 5.2s per call.
INTENT_REASONING_EFFORT=off
# Disk cache of decisions (empty -> DATA_DIR/intent_cache.json). Makes repeated
# questions free and makes an interrupted evaluation resumable.
INTENT_CACHE_PATH=
# Prompt variants (kept switchable so eval/run_ablation.py can compare them).
# v1 and v2 tie on the 23-case ablation (95.7% pass each); v2 adds per-number
# quoting and an explicit conflict section. See eval/ABLATION.md section 5.
PROMPT_INTENT=v1
PROMPT_AGENT=v1
PROMPT_JUDGE=v1

# ---------------- Embeddings (Ollama / embeddinggemma) ----------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
# EmbeddingGemma task prefixes (required by the model card; Ollama does NOT
# add them for you, so we prepend them here). Keep the quotes!
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOC_PREFIX="title: none | text: "
EMBED_BATCH_SIZE=32
RAG_TOP_K=12

# ---------------- Ingestion (rolling-window pipeline) ----------------
# Max characters per rolling read+parse window fed to the LLM (never the
# whole document at once).
INGEST_WINDOW_CHARS=6000
# Set false to skip the LLM parse/summary step (heuristic-only ingestion).
INGEST_LLM_ENABLED=true
# Documents at or below this many characters skip the LLM parse even when it is
# enabled (0 = never skip). Metadata only; the stored chunks are unaffected.
INGEST_HEURISTIC_MAX_CHARS=0
# Opening words the document brief reads (the brief is what the triage layer
# and the agent see when they ask what a document is about).
INGEST_BRIEF_WORDS=1000
# Effort for the window parser. This is structured extraction, not reasoning:
# "off" is 4.2x faster per call and produced the same metadata shape (measured,
# see eval/ABLATION.md). Use "" for the provider default.
INGEST_REASONING_EFFORT=off
# Output cap for one window-parse call (the parse is small; the global ceiling
# is meant for answers).
INGEST_MAX_TOKENS=3000
# Windows parsed concurrently. 1 = the original sequential chain, where window i
# reads a summary of windows < i. >1 parses them independently and folds the
# rolling summary in one extra call. Stored chunks are identical either way.
INGEST_PARALLEL_WINDOWS=4
# Intelligent chunking targets (soft limits; cuts only at paragraph /
# sentence / heading boundaries, never mid-sentence).
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=2200

# ---------------- Retrieval ----------------
RETRIEVAL_MODE=hybrid
RRF_K=60
HYBRID_VECTOR_WEIGHT=1.5
HYBRID_KEYWORD_WEIGHT=0.5

# ---------------- Contradiction tracker ----------------
# Candidate pairs are gated by a SIMILARITY FLOOR, not by a top-k count: a
# conflict can rank 41st among 60 passages that are all similar, so a count cut
# would hide it. The floor below was measured on the sample corpus - the real
# leave-cap conflict (policy v1 vs the 2025 amendment) sits at 0.678.
SCAN_MIN_SIMILARITY=0.65
# Safety valve on total pairs examined per document (cost guard, not a
# relevance decision). When it truncates, the scan log says so.
SCAN_MAX_CANDIDATES=200
# false (default) = scan INSIDE a document as well as across documents.
# true = cross-document pairs only.
SCAN_CROSS_DOC_ONLY=false
JEV_GATE_THRESHOLD=0.5
# Batched, threaded judging. The decision model takes MANY questions over one
# shared state, so a batch of pairs costs one request (measured: 6 pairs = 1.5s /
# 810 input tokens vs 8.7s / 2029 tokens one at a time). Batching shifts scores by
# up to ~0.25 though, so any pair within DECISION_RECHECK_BAND of the threshold is
# re-asked on its own - measured 6/6 agreement with per-pair scoring.
DECISION_BATCH_SIZE=6
DECISION_RECHECK_BAND=0.15

# --- citation recovery (one SystemOne request per answer, only when the endpoint is set)
# The agent reads more than it quotes. After the answer is parsed, every section the agent
# actually read but did not cite is offered to the decision model as a candidate source,
# together with the final answer, and the ones it scores at or above the threshold are
# appended to the citation list. Set to 0 to turn the extra call off.
CITATION_RECOVERY=1
CITATION_RECOVERY_THRESHOLD=0.3
CITATION_RECOVERY_MAX_CANDIDATES=24
CITATION_RECOVERY_MAX_ADDED=3
CITATION_RECOVERY_SNIPPET_CHARS=400
CITATION_RECOVERY_TIMEOUT=20
# Both the gate and the verifier are HTTP calls: run them concurrently.
SCAN_WORKERS=4

# Stage-2 judge of the cascade. It is the ONLY judge: there is no lexical
# fallback verdict, because "do these two rules conflict?" is a question about
# meaning and word overlap cannot answer it. The in-code lexical gate still
# runs, but only to produce signals that are handed to the model as evidence.
# Without DECISION_MODEL_BASE_URL + DECISION_MODEL_NAME a scan reports itself
# INCOMPLETE instead of reporting "no contradictions".
DECISION_MODEL_BASE_URL=
DECISION_MODEL_API_KEY=
DECISION_MODEL_NAME=
DECISION_TEMPERATURE=0.0

# Gate-passing pairs are escalated to the contradiction verifier (stage 3),
# which confirms and explains them with citations.

# ---------------- Storage / server ----------------
DATA_DIR=./data
# Upload ceiling; a larger file is rejected with HTTP 413 before ingestion.
MAX_UPLOAD_MB=20
# A job untouched for this long is marked error at startup, so a document cannot
# stay "ingesting" forever after a killed process.
STALE_JOB_MINUTES=30
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Judge verdict cache: the same (question, answer, contexts, prompt) replays
# its verdict from DATA_DIR/judge_cache.json, so demos are reproducible and
# repeats are free. Set false for a fresh verdict every time.
JUDGE_CACHE=true
