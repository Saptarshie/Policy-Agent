# =====================================================================
# Policy RAG Agent - configuration
# Copy this file to `.env` and edit. All values have sensible defaults.
# NOTE: quote values that contain leading/trailing spaces (see the two
# EMBED_*_PREFIX lines below) - dotenv strips trailing spaces otherwise.
# =====================================================================

# ---------------- LLM (any OpenAI-compatible endpoint) ----------------
# Examples:
#   Ollama:      LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama
#   LM Studio:   LLM_BASE_URL=http://localhost:1234/v1    LLM_API_KEY=lm-studio
#   vLLM:        LLM_BASE_URL=http://localhost:8000/v1    LLM_API_KEY=EMPTY
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
# Requested max output tokens (64k). If the endpoint rejects it, the client
# automatically halves it until the endpoint accepts (see llm.py).
MAX_OUTPUT_TOKENS=65536
TEMPERATURE=0.1

# ---------------- Agent ----------------
AGENT_MAX_STEPS=12
AGENT_MAX_OBS_CHARS=4000
# Post-answer grounding verification: deterministic evidence check + an LLM
# faithfulness judge that compares the answer against the passages the agent
# actually saw. Adds one LLM call per answered question.
VERIFY_ANSWERS=true

# ---------------- Intent & triage layer ----------------
# One LLM call in front of the ReAct loop classifies the raw employee input
# (8 categories), decides the route (REACT_LOOP / DIRECT_REPLY / FAST_REFUSE),
# de-noises it into a neutral HR question and proposes 1-3 formal search
# queries. Non-HR input and prompt injections are refused here; workplace
# questions ALWAYS reach the retrieval agent, which owns coverage refusals.
INTENT_ENABLED=true
# Model for the classifier (empty -> LLM_MODEL). A small/cheap model is fine.
INTENT_MODEL=
# Output budget for the classifier. Too low truncates the JSON mid-object;
# 1500 is the measured safe floor for the v2 prompt.
INTENT_MAX_TOKENS=65536
# Disk cache of decisions (empty -> DATA_DIR/intent_cache.json). Makes repeated
# questions free and makes an interrupted evaluation resumable.
INTENT_CACHE_PATH=
# Prompt variants (kept switchable so eval/run_ablation.py can compare them)
PROMPT_AGENT=v2
PROMPT_JUDGE=v2

# ---------------- Embeddings (Ollama / embeddinggemma) ----------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
# EmbeddingGemma task prefixes (required by the model card; Ollama does NOT
# add them for you, so we prepend them here). Keep the quotes!
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOC_PREFIX="title: none | text: "
EMBED_BATCH_SIZE=32
RAG_TOP_K=6

# ---------------- Ingestion (rolling-window pipeline) ----------------
# Max characters per rolling read+parse window fed to the LLM (never the
# whole document at once).
INGEST_WINDOW_CHARS=6000
# Set false to skip the LLM parse/summary step (heuristic-only ingestion).
INGEST_LLM_ENABLED=true
# Intelligent chunking targets (soft limits; cuts only at paragraph /
# sentence / heading boundaries, never mid-sentence).
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=2200

# ---------------- Contradiction tracker ----------------
# Stage-2 DECISION MODEL of the cascade (runs BEFORE the LLM verifier):
#
#   DECISION_MODE=heuristic  (default)
#       JEV-style decision model implemented IN CODE (app/contradictions/
#       gate.py): regex lexicons + weighted signals + threshold. Deterministic,
#       explainable, ZERO LLM cost - no endpoint/key needed. This is why
#       there is no decision-model endpoint configured by default.
#
#   DECISION_MODE=remote
#       Score every candidate pair with a dedicated, separately served
#       OpenAI-compatible model (can be a DIFFERENT, cheaper endpoint than
#       LLM_* above - e.g. qwen2.5:0.5b on another Ollama instance, or a
#       hosted small classifier). It must answer strict JSON
#       {"score": 0..1, "signals": [...]}; replies are repaired heuristically,
#       retried once with the parse error fed back, and on any failure the
#       gate falls back to the in-code heuristic.
#
#   DECISION_MODE=hybrid
#       Heuristic scores first (free); only BORDERLINE pairs (score within
#       DECISION_BORDERLINE_BAND of JEV_GATE_THRESHOLD) are refined by the
#       remote decision model. Clear pass / clear fail never hit the network.
#
# Gate-passing pairs are then escalated to the contradiction_detector LLM
# (stage 3) which verifies and explains them with citations.
DECISION_MODE=heuristic
# --- remote decision model endpoint (only used when DECISION_MODE is
#     remote/hybrid; leave empty to stay pure-heuristic) ---
# Example (small local model on Ollama):
#   DECISION_MODEL_BASE_URL=http://localhost:11434/v1
#   DECISION_MODEL_API_KEY=ollama
#   DECISION_MODEL_NAME=qwen2.5:0.5b
# Example (hosted):
#   DECISION_MODEL_BASE_URL=https://api.openai.com/v1
#   DECISION_MODEL_API_KEY=sk-...
#   DECISION_MODEL_NAME=gpt-4o-mini
DECISION_MODEL_BASE_URL=
DECISION_MODEL_API_KEY=
DECISION_MODEL_NAME=
# Scoring is a tiny JSON reply - a few hundred tokens are plenty.
# Deterministic scoring: keep the decision model at temperature 0.
DECISION_TEMPERATURE=0.0
# hybrid mode only: pairs within +/- this band of JEV_GATE_THRESHOLD are
# refined by the remote decision model.
DECISION_BORDERLINE_BAND=0.15
# If the remote decision model fails, fall back to the in-code heuristic
# instead of dropping the pair (recommended: the cascade never breaks).
DECISION_FALLBACK_HEURISTIC=true
# Pairs scoring >= this threshold escalate to the LLM verifier.
JEV_GATE_THRESHOLD=0.5
# RAG: how many neighbour passages to retrieve per chunk during a scan.
CONTRA_TOP_K=4
# Only compare passages across different documents (recommended).
SCAN_CROSS_DOC_ONLY=true
# Max gate-passing pairs sent to the LLM verifier per chunk (cost cap).
SCAN_MAX_PAIRS_PER_CHUNK=3

# ---------------- Storage / server ----------------
DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
